+def _diag_open(self):
+    self._ks_admit_log = None
+    self._ks_admit_adapter = None
+    path = _diag_os.environ.get("KS_ADMIT_DIAG_DIR")
+    if not path:
+        return
+    for child in getattr(self.connector, "_connectors", [self.connector]):
+        adapter = getattr(child, "scheduler_adapter", None)
+        if hasattr(adapter, "_unacked_lookups"):
+            self._ks_admit_adapter = adapter
+            break
+    _diag_os.makedirs(path, exist_ok=True)
+    self._ks_admit_log = open(
+        _diag_os.path.join(path, f"admit-{_diag_os.getpid()}.jsonl"),
+        "a", encoding="utf-8", buffering=1,
+    )
+
+
+def _diag_end(self, pending, token_budget, kv_none, defer_prefills, preempted_reqs,
+              allocated, scheduled, started_ns):
+    adapter = self._ks_admit_adapter
+    t0 = time.monotonic_ns()
+    for entry in pending:
+        req_id = entry[0]
+        ready = None
+        if adapter is not None:
+            known = adapter._per_server_hits.get(req_id, {})
+            ack = adapter._unacked_lookups.get(req_id)
+            if req_id in adapter._finished_lookup_results or any(v == 0 for v in known.values()):
+                ready = True
+            else:
+                fs = ack.futures if ack is not None else {}
+                ready = all(u in known or (u in fs and fs[u].query()) for u in adapter._server_urls)
+        entry.append(ready)
+    # Observe readiness only, without consuming results or reserving cache blocks.
+    head = self.skipped_waiting.peek_request().request_id if self.skipped_waiting else None
+    free = getattr(getattr(self.kv_cache_manager, "block_pool", None), "get_num_free_blocks", None)
+    rec = dict(step=self.current_step, start=started_ns, snapshot_start=t0,
+               cut=time.monotonic_ns(), budget=token_budget,
+               slots=self.max_num_running_reqs-len(self.running)-self.num_waiting_for_streaming_input,
+               free=free() if callable(free) else None, kv_fail=kv_none,
+               defer=bool(defer_prefills), preempted=len(preempted_reqs),
+               waiting=len(self.waiting), skipped=len(self.skipped_waiting), head=head,
+               scheduled=scheduled, allocated=allocated, pending=pending)
+    self._ks_admit_log.write(_diag_json.dumps(rec, separators=(",", ":")) + "\n")
+
+
