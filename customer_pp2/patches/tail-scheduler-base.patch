+    def _wait_inline_lookup(self, request_id: str) -> tuple[int, int]:
+        """Observe existing ACK futures on the scheduler thread; consume via the connector."""
+        ack = self._tail_lookup_adapter._unacked_lookups.get(request_id)
+        if not ack:
+            return 0, 0
+        start = time.perf_counter_ns()
+        deadline = start + 20_000_000
+        waits = 0
+        while True:
+            pending = []
+            for future in ack.futures.values():
+                if not future.query():
+                    pending.append(future)
+                    continue
+                # A final zero permits an early miss. A legacy reply or error
+                # belongs to normal STATUS/error handling, without extra delay.
+                try:
+                    if not future.result(timeout=0):
+                        return waits, time.perf_counter_ns() - start if waits else 0
+                except Exception:
+                    return waits, time.perf_counter_ns() - start if waits else 0
+            remaining = deadline - time.perf_counter_ns()
+            if not pending or remaining <= 0:
+                return waits, time.perf_counter_ns() - start if waits else 0
+            # For two pending peers, allow the other peer's zero to end the
+            # wait promptly. Every wait spends the same monotonic deadline.
+            timeout = remaining if len(pending) == 1 else min(remaining, 1_000_000)
+            waits += 1
+            pending[0].wait(timeout=timeout / 1e9)
+
